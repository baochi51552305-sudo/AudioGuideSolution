{
  "openapi": "3.0.1",
  "info": {
    "title": "AudioGuide.API",
    "version": "1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "AudioGuide.API"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/GeoGuide/locate": {
      "post": {
        "tags": [
          "GeoGuide"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GpsLocationRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GpsLocationRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GpsLocationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PoiNarrativeDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoiNarrativeDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoiNarrativeDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/QrGuide/audio": {
      "get": {
        "tags": [
          "QrGuide"
        ],
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "vi"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/QrGuide/scan/{token}": {
      "get": {
        "tags": [
          "QrGuide"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "vi"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/QrGuide/generate/{token}": {
      "get": {
        "tags": [
          "QrGuide"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "vi"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GpsLocationRequest": {
        "type": "object",
        "properties": {
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "languageCode": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PoiNarrativeDto": {
        "type": "object",
        "properties": {
          "poiId": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "audioUrl": {
            "type": "string",
            "nullable": true
          },
          "durationSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "languageCode": {
            "type": "string",
            "nullable": true
          },
          "distanceMeters": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
  }
}